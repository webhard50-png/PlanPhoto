<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PlanPhoto" parent="Theme.AppCompat.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/slate</item>
        <item name="colorPrimaryDark">@color/ink</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:statusBarColor">@color/ink</item>
    </style>

    <style name="Theme.PlanPhoto.Camera" parent="Theme.AppCompat.NoActionBar">
        <item name="colorAccent">@color/pin_orange</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>

    <style name="PrimaryButton" parent="Widget.AppCompat.Button.Colored">
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/button_bg</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>
</resources>
